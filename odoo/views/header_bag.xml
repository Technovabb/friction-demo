<data name="Friction cart icon and Enquiry List link">
  <!-- Odoo's real cart stays (bag icon); the Enquiry List (styled looks and sold-out sizes, sent on WhatsApp) sits beside it and only shows once it has something in it -->
  <xpath expr="//a[@href='/shop/cart']//i" position="replace">
    <svg class="fr-bag-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 8h13l-1 12.5h-11z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
  </xpath>
  <xpath expr="//a[@href='/shop/cart']" position="attributes">
    <attribute name="aria-label">Cart</attribute>
    <attribute name="title">Cart</attribute>
  </xpath>
  <xpath expr="//li[contains(@t-attf-class, 'o_wsale_my_cart')]" position="after">
    <li t-attf-class="fr-enq-li d-none #{_item_class}">
      <a href="/enquiry-bag" t-attf-class="#{_link_class} fr-baglink" aria-label="Enquiry List" title="Enquiry List">
        <div t-attf-class="#{_icon_wrap_class}">
          <svg class="fr-bag-ico" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5h16v10H9l-5 4z"/><path d="M8 9h8M8 12h5"/></svg>
          <sup t-attf-class="fr-bag-count badge bg-primary #{_badge_class} d-none">0</sup>
        </div>
        <span t-if="_text" t-attf-class="#{_text_class}">Enquiry List</span>
      </a>
    </li>
  </xpath>
</data>
