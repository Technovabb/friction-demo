<data name="Friction enquiry call to action">
  <!-- Styled looks have no price, so Odoo blocks the cart for them ("Hide Add To Cart" for 0 price products).
       This block replaces Odoo's Contact Us button and only shows when the cart is blocked. -->
  <xpath expr="//div[@id='contact_us_wrapper']" position="replace">
    <div id="contact_us_wrapper" t-attf-class="{{'d-flex' if combination_info['prevent_sale'] else 'd-none'}} flex-column w-100 gap-3 fr-cta">
      <div class="fr-size">
        <label class="fr-size-label" t-attf-for="fr-size-#{product.id}">Size — availability to confirm</label>
        <select class="form-select fr-size-select" t-attf-id="fr-size-#{product.id}">
          <option value="" selected="selected">Select a size</option>
          <option value="S">S</option>
          <option value="M">M</option>
          <option value="L">L</option>
          <option value="XL">XL</option>
          <option value="2XL">2XL</option>
        </select>
        <p class="fr-size-help">Optional. Choosing a size adds it to your message; it does not mean the size is in stock.</p>
      </div>
      <a class="btn btn-primary w-100 fr-check" href="https://wa.me/12466221748" target="_blank" rel="noopener" t-att-data-look="product.name">Check Price &amp; Availability</a>
    </div>
  </xpath>
  <!-- Store items: when the chosen size is sold out, Odoo hides Add to cart and shows this block instead.
       Odoo's own Notify me buttons stay in the page (its script uses them) but are hidden by the site CSS. -->
  <xpath expr="//div[@id='out_of_stock_buttons_wrapper']" position="inside">
    <div class="fr-oos w-100">
      <a class="btn btn-primary w-100 fr-check" href="https://wa.me/12466221748" target="_blank" rel="noopener" t-att-data-look="product.name" data-item="1">Sold Out Online · Ask on WhatsApp</a>
      <button type="button" class="fr-btn fr-btn-outline fr-bag-add w-100" t-att-data-pid="product.id" t-att-data-look="product.name" t-att-data-url="product.website_url" t-attf-data-img="/web/image/product.template/#{product.id}/image_256" t-att-data-price="product.list_price or None">Add to Enquiry List</button>
    </div>
  </xpath>
</data>
