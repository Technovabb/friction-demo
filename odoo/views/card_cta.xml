<data name="Friction card call to action">
  <xpath expr="//div[hasclass('o_wsale_product_action_row')]" position="replace">
    <div class="o_wsale_product_action_row">
      <a t-if="product.list_price" class="btn btn-primary fr-card-cta" href="https://wa.me/12466221748" target="_blank" rel="noopener" t-att-data-look="product.name" t-att-data-sku="product.default_code or None" data-item="1" t-attf-aria-label="Check availability of #{product.name} on WhatsApp">Check Availability</a>
      <a t-else="" class="btn btn-primary fr-card-cta" href="https://wa.me/12466221748" target="_blank" rel="noopener" t-att-data-look="product.name" t-attf-aria-label="Check price and availability for #{product.name} on WhatsApp">Check Price &amp; Availability</a>
    </div>
  </xpath>
</data>
